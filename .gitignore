# Exclude the 1.25 GB raw whole-genome FASTA corpus to respect GitHub 100MB limit
# (Users can download the full corpus using python scripts/stage2_download_real_genomes.py)
# Track only the 15 curated benchmark clinical FASTA genomes for immediate testing & Streamlit demo
data/fastas/*.fna
!data/fastas/562.100000.fna
!data/fastas/562.100001.fna
